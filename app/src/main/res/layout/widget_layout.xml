<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Search row: tap field → type/voice first; tap globe → web panel directly -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_web_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔎"
                android:textColor="#A0A09C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_web_search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Search the web or enter URL"
                android:textColor="#A0A09C"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_web_open_panel"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="Open web panel"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textColor="#C8FB5E"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top row: Quick Note | Conversations -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Quick Note -->
        <LinearLayout
            android:id="@+id/btn_quick_note"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:textColor="#F0F0EE"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_quick_note_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Notes"
                android:textColor="#A0A09C"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Conversations picker -->
        <LinearLayout
            android:id="@+id/btn_conversations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tv_conversation_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Conversations ▾"
                android:textColor="#F0F0EE"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom row: Ask Eidos | Send | Chat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- Mic — colour changes with state -->
        <LinearLayout
            android:id="@+id/btn_mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_mic_idle_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_mic_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask Eidos"
                android:textColor="#A0A09C"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Send — commits accumulated transcript and sends to Eidos -->
        <LinearLayout
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_send_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➤"
                android:textColor="#C8FB5E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_send_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                android:textColor="#A0A09C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Chat — opens the currently active conversation -->
        <LinearLayout
            android:id="@+id/btn_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textColor="#F0F0EE"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#A0A09C"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
